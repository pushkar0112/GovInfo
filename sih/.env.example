# ==============================================================================
# GovInnovate - Environment Configuration Template
# Copy this file to .env for local development:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PROJECT_NAME="GovInnovate API"
API_V1_STR=/api/v1
BACKEND_PORT=8000

# Security (Generate a secure secret in production: openssl rand -hex 32)
JWT_SECRET=change-this-to-a-secure-random-jwt-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Connection
# For local host development without PostgreSQL, you can use SQLite fallback:
# DATABASE_URL=sqlite:///./govinnovate.db
# For PostgreSQL (Default in Docker):
DATABASE_URL=postgresql://govinnovate:govinnovate_secure_pass@localhost:5432/govinnovate_db

# ------------------------------------------------------------------------------
# PostgreSQL Database (Docker & Production)
# ------------------------------------------------------------------------------
POSTGRES_USER=govinnovate
POSTGRES_PASSWORD=govinnovate_secure_pass
POSTGRES_DB=govinnovate_db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Frontend Configuration (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="GovInnovate"
NEXT_PUBLIC_APP_ENV=development
PORT=3000
